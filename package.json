{
  "name": "@local/dsh-models-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "模型清单与余额管理：列出当前模型列表中的全部 provider / 模型及其可查到的余额信息",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "meta": {
    "title": "模型用量与余额",
    "description": "列出模型列表中的每个服务商与模型，并查询可获得的余额信息"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@types/node": "^26.6.4",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  }
}
